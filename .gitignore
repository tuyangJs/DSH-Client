# ================= 本地运行数据（含密钥/会话，严禁提交） =================
# dsh-home 为客户端隔离数据目录：settings.yaml 可能含 API Key，
# sessions/ 含历史会话数据，profiles/ 下为按需安装的依赖（约百 MB）
dsh-home/
# WebView2 用户数据目录（源码运行时生成于项目根目录）
jadeview-data/
# DSH 自动更新的暂存/备份目录（npm install 原子换目录的残留）
dsh_stage_*/
dsh_old_*/

# ================= 内置运行时与依赖 =================
# 捆绑的 Node.js 运行时（node.exe / npm / npx 等二进制，随发行版发布而非入库）
runtime/
node_modules/
dsh/node_modules/

# ================= 构建产物 / 缓存 =================
# Nuitka 打包输出（生成的 exe 与资源）
dist/
# Nuitka 构建缓存
.nuitka-cache/
nuitka-crash-report.xml
*.build/
*.manifest

# ================= Python =================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ================= 环境变量 / 密钥 =================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ================= IDE / 编辑器 =================
.idea/
.vscode/
*.swp
*.swo
*~

# ================= 操作系统 =================
.DS_Store
Thumbs.db
Desktop.ini

# ================= 日志 =================
*.log
logs/